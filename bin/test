#!/usr/bin/env bash
# Run upstream Nokogiri's test suite against this pure-Ruby implementation.
# usage: bin/test                       # everything
#        bin/test test/xml/test_node.rb # selected files (paths relative to upstream checkout)
#        bin/test test/xml/test_node.rb -n /namespace/
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
UPSTREAM="${NOKOGIRI_UPSTREAM:-$ROOT/../nokogiri-upstream}"
cd "$UPSTREAM"
export MT_NO_PLUGINS=1
files=()
args=()
for a in "$@"; do
  if [[ "$a" == test/* || "$a" == *.rb ]]; then files+=("$a"); else args+=("$a"); fi
done
if [ ${#files[@]} -eq 0 ]; then
  mapfile -t files < <(find test -name 'test_*.rb' | sort)
fi
exec ruby -W0 -I"$ROOT/lib" -Itest -e 'gem "minitest", "~> 5.0"; i = ARGV.index("--"); files = ARGV.shift(i); ARGV.shift; files.each { |f| require File.expand_path(f) }' -- "${files[@]}" -- "${args[@]}"
