#!/usr/bin/env bash
# Run upstream tests against the installed *native* nokogiri gem (to see what native does).
# usage: bin/test                       # everything
#        bin/test test/xml/test_node.rb # selected files (paths relative to upstream checkout)
#        bin/test test/xml/test_node.rb -n /namespace/
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export NOKOGIRI_LIB="${NOKOGIRI_LIB:-/usr/local/lib/ruby/gems/4.0.0/gems/nokogiri-1.19.4-x86_64-linux-gnu/lib}"
UPSTREAM="${NOKOGIRI_UPSTREAM:-$ROOT/../nokogiri-upstream}"
cd "$UPSTREAM"
export MT_NO_PLUGINS=1
files=()
args=()
for a in "$@"; do
  if [[ "$a" == test/* || "$a" == *.rb ]]; then files+=("$a"); else args+=("$a"); fi
done
if [ ${#files[@]} -eq 0 ]; then
  mapfile -t files < <(find test -name 'test_*.rb' | sort)
fi
exec ruby -W0 -I"${NOKOGIRI_LIB:-$ROOT/lib}" -Itest -e 'gem "minitest", "~> 5.0"; i = ARGV.index("--"); files = ARGV.shift(i); ARGV.shift; files.each { |f| require File.expand_path(f) }' -- "${files[@]}" -- "${args[@]}"
